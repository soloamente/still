# Discord profile activity — copy values into apps/server/.env
# Application: https://discord.com/developers/applications/870937412975620096
#
# Public key (interactions / slash commands) is NOT used by Sense Lanyard OAuth —
# you can ignore it unless you add Discord webhooks later.
#
# ── Feature flag ──────────────────────────────────────────────────────────────
DISCORD_ACTIVITY_ENABLED=true
#
# ── OAuth (Developer Portal → OAuth2) ─────────────────────────────────────────
# Client ID = Application ID below. Client Secret: OAuth2 → Reset Secret (once).
DISCORD_CLIENT_ID=870937412975620096
DISCORD_CLIENT_SECRET=
#
# ── Bot (Developer Portal → Bot → Reset Token) ────────────────────────────────
# Same token for DISCORD_BOT_TOKEN and Lanyard docker compose (BOT_TOKEN).
# Required intents: PRESENCE + SERVER MEMBERS (Privileged Gateway Intents).
DISCORD_BOT_TOKEN=
#
# ── Sense Presence guild ──────────────────────────────────────────────────────
# Create a private Discord server, add this bot, enable Developer Mode,
# right-click the server → Copy Server ID.
DISCORD_PRESENCE_GUILD_ID=
#
# ── Lanyard (self-hosted — docker/discord-lanyard.compose.yml) ────────────────
# Local API on host: bun dev uses apps/server → http://127.0.0.1:4001
LANYARD_INTERNAL_URL=http://127.0.0.1:4001
#
# ── Docker Compose only (export before `docker compose up`) ───────────────────
# DISCORD_BOT_TOKEN=<same as above>
